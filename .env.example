# xAI (Grok) API acari - https://console.x.ai ünvanindan alin
XAI_API_KEY=xai-...

# Neon Postgres bağlanti setiri - https://console.neon.tech saytinda layihe yaradib buradan kopyalayin
# Formati: postgresql://istifadeci:sifre@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx.region.aws.neon.tech/neondb?sslmode=require

# Server portu (isteğe bağli, defolt 3000)
PORT=3000
